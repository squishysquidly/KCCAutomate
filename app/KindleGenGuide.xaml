<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Find KindleGen · KCCAutomate" Width="870" Height="760" MinWidth="710" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="GuideNumber" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SoftBrush}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
    <Style x:Key="GuideFolder" TargetType="Path"><Setter Property="Data" Value="M 1,6 L 1,22 L 29,22 L 29,5 L 14,5 L 10,1 L 1,1 Z"/><Setter Property="Fill" Value="#F0BC50"/><Setter Property="Stroke" Value="#896321"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="24"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Margin" Value="0,0,9,0"/></Style>
  </Window.Resources>
  <Grid Margin="26" Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Find the file that makes MOBI books" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="KindleGen comes from Amazon. You obtain it yourself using KCC's guide, then select the file in setup. Already have a working kindlegen.exe? Use that copy." Style="{DynamicResource Hint}"/></StackPanel>
    <ScrollViewer x:Name="GuideSteps" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <DockPanel Margin="0,0,0,22"><Border Style="{StaticResource GuideNumber}" DockPanel.Dock="Left"><TextBlock Text="1" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Open the installation folder" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Try the button below. It checks the usual Kindle Previewer 3, Previewer 4 and Kindle Comic Creator locations, and any location you have selected. It opens a folder for you to inspect." Style="{DynamicResource Hint}"/><Button x:Name="GuideOpenFolder" Content="Open likely installation folder" HorizontalAlignment="Left" Style="{DynamicResource Primary}"/><TextBlock Text="No folder found? Open KCC's guide below. It explains where to obtain Amazon's tools. For a custom install, browse to its location yourself." Style="{DynamicResource Hint}"/></StackPanel></DockPanel>
      <DockPanel Margin="0,0,0,22"><Border Style="{StaticResource GuideNumber}" DockPanel.Dock="Left"><TextBlock Text="2" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Follow this folder route" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Start in the Kindle Previewer installation folder. Open each folder in order:" Style="{DynamicResource Hint}"/>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,8"><StackPanel>
          <StackPanel Orientation="Horizontal"><Path Style="{StaticResource GuideFolder}"/><TextBlock Text="Kindle Previewer installation" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="18,9,0,0"><TextBlock Text="↳" Width="24" VerticalAlignment="Center"/><Path Style="{StaticResource GuideFolder}"/><TextBlock Text="lib" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="42,9,0,0"><TextBlock Text="↳" Width="24" VerticalAlignment="Center"/><Path Style="{StaticResource GuideFolder}"/><TextBlock Text="fc" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="66,9,0,0"><TextBlock Text="↳" Width="24" VerticalAlignment="Center"/><Path Style="{StaticResource GuideFolder}"/><TextBlock Text="bin" VerticalAlignment="Center"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="90,10,0,0"><TextBlock Text="↳" Width="24" VerticalAlignment="Center"/><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6"><TextBlock Text="kindlegen.exe" FontWeight="SemiBold"/></Border></StackPanel>
        </StackPanel></Border>
        <TextBlock Text="Illustrated folder route; layouts and installation locations can vary. Choose kindlegen.exe, the compiler file inside bin." Style="{DynamicResource Hint}"/>
        <Expander x:Name="GuideWindowsHelp" Header="Windows has no 'Open file location' option" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"><TextBlock Text="Use Open likely installation folder above. If your installation is elsewhere, open File Explorer and browse to it directly. A Start menu shortcut can lead to another shortcut; keep following its location until you see the installation's lib folder. You can also paste your known folder into setup." Style="{DynamicResource Hint}"/></Expander>
      </StackPanel></DockPanel>
      <DockPanel Margin="0,0,0,12"><Border Style="{StaticResource GuideNumber}" DockPanel.Dock="Left"><TextBlock Text="3" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Return to setup and select it" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Close this guide, click Choose kindlegen.exe, and select that file. You can also paste its containing folder. Wait for the green check before continuing." Style="{DynamicResource Hint}"/><Border Background="{DynamicResource SoftBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,8"><TextBlock Text="✓ KindleGen · validated" FontWeight="SemiBold"/></Border><TextBlock Text="Example of the result you are looking for. Your selection still needs to pass the actual check in setup. Later, KCCAutomate copies your chosen tools into its own tools folder." Style="{DynamicResource Hint}"/></StackPanel></DockPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="GuideFeedback" Text="Tip: a working copy from your previous conversion setup is fine." TextWrapping="Wrap" Margin="0,0,0,12"/><DockPanel><Button x:Name="GuideKccLink" Content="Open KCC's KindleGen guide" DockPanel.Dock="Left"/><Button x:Name="GuideDone" Content="Return to setup" HorizontalAlignment="Right" Style="{DynamicResource Primary}" IsCancel="True"/></DockPanel></StackPanel>
  </Grid>
</Window>
