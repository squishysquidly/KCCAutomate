<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up MangaFlow" Width="1010" Height="760" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Background="{DynamicResource CanvasBrush}" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Let's get your first book ready." FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="StepTitle" Margin="0,9,0,20"/></StackPanel>
    <TabControl x:Name="Steps" Grid.Row="1" BorderThickness="0" Background="Transparent">
      <TabItem Header="Welcome"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="One setup. A smoother reading routine." FontSize="21" Margin="0,10,0,14"/>
        <TextBlock Text="We will choose your folders, connect your conversion tools, and optionally test a book. No downloads are installed and no schedule is enabled until you ask." TextWrapping="Wrap" Margin="0,0,0,24"/>
        <TextBlock Text="Your reader" Style="{DynamicResource Label}"/><ComboBox x:Name="Device" DisplayMemberPath="Label" SelectedValuePath="Code"/>
        <TextBlock Text="Book format" Style="{DynamicResource Label}"/><ComboBox x:Name="Format"><ComboBoxItem Content="MOBI"/><ComboBoxItem Content="EPUB"/><ComboBoxItem Content="CBZ"/><ComboBoxItem Content="PDF"/></ComboBox>
        <CheckBox x:Name="Manga" Content="Read manga from right to left" Margin="0,18,0,8"/>
        <TextBlock Text="Your other conversion settings stay as they are. You can review them in Conversion after setup." Style="{DynamicResource Hint}"/>
        <TextBlock x:Name="StorageInfo" TextWrapping="Wrap" Style="{DynamicResource Hint}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Folders"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Choose a folder for each stage" FontSize="21" Margin="0,10,0,10"/>
        <TextBlock Text="Network paths such as \\server\share\manga are supported. Use separate folders; none can be inside another." Style="{DynamicResource Hint}"/>
        <TextBlock Text="Incoming completed downloads" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="WatchBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Watch"/></DockPanel>
        <TextBlock Text="Converted books" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="OutputBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Output"/></DockPanel>
        <TextBlock Text="Archived originals" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="ArchiveBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Archive"/></DockPanel>
        <TextBlock Text="Temporary processing and logs" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="WorkBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Work"/></DockPanel>
        <TextBlock Text="The access check creates missing output/archive/working folders and tiny temporary probe files, then removes the probes. Your books are untouched." Style="{DynamicResource Hint}"/>
        <Button x:Name="CheckFolders" Content="Check folder access" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Tools"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Connect the tools you already have" FontSize="21" Margin="0,10,0,12"/>
        <Button x:Name="FindTools" Content="Find installed tools" HorizontalAlignment="Left"/>
        <TextBlock Text="KCC command-line converter (c2e)" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="KccBrowse" Content="Choose .exe" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Kcc"/></DockPanel>
        <CheckBox x:Name="JxlEnabled" Content="Prepare JPEG XL pages automatically" Margin="0,15,0,8"/>
        <DockPanel><Button x:Name="JxlBrowse" Content="Choose djxl.exe" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Jxl"/></DockPanel>
        <TextBlock Text="KindleGen (needed for MOBI)" Style="{DynamicResource Label}"/><DockPanel><Button x:Name="KindleBrowse" Content="Choose .exe" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="Kindle"/></DockPanel>
        <TextBlock Text="Find installed tools checks common application folders, including Kindle Previewer's lib\fc\bin folder. You can select files manually. KindleGen's folder is added only to conversion processes, not your system settings." Style="{DynamicResource Hint}"/>
        <WrapPanel><Button x:Name="CheckTools" Content="Check tools"/><Button x:Name="GetKcc" Content="Get KCC"/><Button x:Name="GetJxl" Content="Get JXL tools"/><Button x:Name="GetKindle" Content="KindleGen help"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Test"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Try one book before automating" FontSize="21" Margin="0,10,0,14"/>
        <TextBlock Text="Choose a small completed comic. We copy it into an isolated test area in your working folder, convert that copy, and keep the result there. The selected original and your normal incoming/archive folders are not changed." TextWrapping="Wrap" Margin="0,0,0,24"/>
        <DockPanel><Button x:Name="TestBrowse" Content="Choose a book" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="TestBook"/></DockPanel>
        <WrapPanel Margin="0,18,0,14"><Button x:Name="RunTest" Content="Run test conversion" Style="{DynamicResource Primary}"/><Button x:Name="OpenTest" Content="Open test results" IsEnabled="False"/></WrapPanel>
        <TextBlock Text="You can skip this step and test later. A tool startup check alone does not verify a complete Kindle conversion." Style="{DynamicResource Hint}"/>
        <TextBox x:Name="TestLog" Height="230" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Schedule"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Choose when to check for books" FontSize="21" Margin="0,10,0,16"/>
        <CheckBox x:Name="EnableSchedule" Content="Enable automatic checks when I finish setup"/>
        <TextBlock Text="Daily times (24-hour clock)" Style="{DynamicResource Label}"/><TextBox x:Name="Times"/>
        <TextBlock Text="Separate times with commas, such as 08:00, 14:00, 20:00." Style="{DynamicResource Hint}"/>
        <TextBlock Text="Wait after downloads were last modified (minutes)" Style="{DynamicResource Label}"/><TextBox x:Name="QuietMinutes"/>
        <CheckBox x:Name="Wake" Content="Ask Windows to wake the computer for checks" Margin="0,18,0,10"/>
        <TextBlock x:Name="ScheduleInfo" TextWrapping="Wrap"/>
        <TextBlock Text="Turning on this option creates or replaces MangaFlow's task for your Windows account and points it at this copy of the app. Other manually created conversion tasks are not changed." Style="{DynamicResource Hint}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Review"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Ready when you are" FontSize="21" Margin="0,10,0,20"/>
        <TextBlock x:Name="Summary" TextWrapping="Wrap"/>
        <TextBlock Text="Finish saves this setup. No conversion of your normal queue is started. You can run Preview queue first and change any setting later." Style="{DynamicResource Hint}" Margin="0,24,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="{DynamicResource SoftBrush}" Padding="12" CornerRadius="6" Margin="0,16,0,16"><TextBlock x:Name="Feedback" Text="Welcome. Your current settings are prefilled if available." TextWrapping="Wrap"/></Border>
    <DockPanel Grid.Row="3"><Button x:Name="CancelSetup" Content="Set up later" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Back" Content="Back"/><Button x:Name="Next" Content="Continue" Style="{DynamicResource Primary}"/></StackPanel></DockPanel>
  </Grid>
</Window>
