<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KCCAutomate" Width="1180" Height="850" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F5F1"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#27372F"/><SolidColorBrush x:Key="HintBrush" Color="#647168"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D5DDD5"/><SolidColorBrush x:Key="SoftBrush" Color="#E5ECDF"/>
    <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="9"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource HintBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,5,0,16"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,7"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,15,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#23654C"/><Setter Property="BorderBrush" Value="#23654C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,4"/><Setter Property="Background" Value="#203D32"/><Setter Property="Foreground" Value="#E0EBDD"/><Setter Property="BorderBrush" Value="#345244"/><Setter Property="Padding" Value="16,13"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Visibility="Collapsed"/></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#17382C" Padding="22,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="KCCAutomate" FontSize="27" FontWeight="SemiBold" Foreground="#F2F7EC"/>
          <TextBlock Text="FROM FOLDER TO READER" FontSize="10" Foreground="#AEC4B4" Margin="0,8,0,35"/>
          <Button x:Name="QueueNav" Content="Queue dashboard" Style="{StaticResource Nav}"/>
          <Button x:Name="FoldersNav" Content="01   Folders &amp; tools" Style="{StaticResource Nav}"/>
          <Button x:Name="ConversionNav" Content="02   Conversion" Style="{StaticResource Nav}"/>
          <Button x:Name="ScheduleNav" Content="03   Schedule" Style="{StaticResource Nav}"/>
          <Button x:Name="ActivityNav" Content="04   Activity" Style="{StaticResource Nav}"/>
          <Button x:Name="PreferencesNav" Content="Settings &amp; updates" Style="{StaticResource Nav}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Background="#284B3B" CornerRadius="8" Padding="14">
            <StackPanel><TextBlock x:Name="OriginalsHeading" Text="Your originals, preserved." Foreground="#DDEACD" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="OriginalsSummary" Text="Files move to Originals after successful conversion and verification." Foreground="#B6CBB8" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel>
          </Border>
          <TextBlock Text="Powered by your KCC installation" Foreground="#9FB9A7" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,27,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="SimpleView" Content="Simple" Padding="13,8" AutomationProperties.Name="Switch to Simple view"/><Button x:Name="AdvancedView" Content="Advanced" Padding="13,8" Margin="0" AutomationProperties.Name="Switch to Advanced view"/></StackPanel><TextBlock Text="A quieter way to convert." FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
        <TextBlock x:Name="ViewDescription" Text="Everyday controls. Your saved advanced settings still apply." Style="{StaticResource Hint}" Margin="0,8,0,16"/>
      </StackPanel>
      <StackPanel Grid.Row="1"><Border x:Name="FolderErrorBanner" Visibility="Collapsed" Background="#FAE8E7" CornerRadius="7" Padding="13,10" Margin="0,0,0,12"><StackPanel><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="FolderErrorText" Foreground="#792A25" TextWrapping="Wrap"/></ScrollViewer><WrapPanel Margin="0,10,0,0"><Button x:Name="OpenFoldersFromError" Content="Open folders"/><Button x:Name="RecheckFolders" Content="Check saved folders again"/></WrapPanel></StackPanel></Border>
      <Border x:Name="ToolUpdateNotice" Visibility="Collapsed" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="13,10" Margin="0,0,0,12"><StackPanel>
        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ToolUpdateMessage" TextWrapping="Wrap"/></ScrollViewer>
        <WrapPanel Margin="0,10,0,0"><Button x:Name="NoticeKccReleases" Content="Open KCC releases"/><Button x:Name="NoticeChooseKcc" Content="Choose downloaded KCC"/><Button x:Name="NoticeViewUpdates" Content="View updates"/><Button x:Name="DismissToolNotice" Content="Dismiss"/></WrapPanel>
      </StackPanel></Border>
      <Border Background="{DynamicResource SoftBrush}" CornerRadius="7" Padding="13,10" Margin="0,0,0,18">
        <TextBlock x:Name="Status" Text="Start by choosing your folders and converter." TextWrapping="Wrap"/>
      </Border></StackPanel>
      <TabControl x:Name="Pages" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0">
        <TabItem Header="Folders">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="A home for every stage" FontSize="20" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,12,0,0"><Button x:Name="GuidedSetup" Content="Guided setup"/><Button x:Name="PrepareBookFolders" Content="Create &amp; check folders"/></WrapPanel>
                <TextBlock Text="Choose local folders or network shares, then Create &amp; check folders to save the paths, create missing folders and verify access. Keep these locations separate." Style="{StaticResource Hint}"/>
                <TextBlock Text="Incoming/Watch Folder (The folder you place the original comics/manga you're trying to convert)" TextWrapping="Wrap" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="WatchBrowse" DockPanel.Dock="Right" Content="Browse" Margin="10,0,0,0"/><TextBox x:Name="WatchFolder" AutomationProperties.Name="Watch folder"/></DockPanel>
                <TextBlock Text="Drop completed downloads here. Subfolders retain their structure." Style="{StaticResource Hint}"/>
                <TextBlock Text="Converted (Folder where converted books will be placed)" TextWrapping="Wrap" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="ConvertedBrowse" DockPanel.Dock="Right" Content="Browse" Margin="10,0,0,0"/><TextBox x:Name="ConvertedFolder" AutomationProperties.Name="Converted books folder"/></DockPanel>
                <TextBlock Text="Originals (Folder where original comics/manga will be moved to after conversion)" TextWrapping="Wrap" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="ArchiveBrowse" DockPanel.Dock="Right" Content="Browse" Margin="10,0,0,0"/><TextBox x:Name="ArchiveFolder" AutomationProperties.Name="Archive folder"/></DockPanel>
                <TextBlock Text="Matching archived files are replaced. Other archived files are kept." Style="{StaticResource Hint}"/>
                <TextBlock x:Name="SimpleWorkSummary" Style="{StaticResource Hint}"/>
                <Expander x:Name="AdvancedWork" Header="Working folder" Margin="0,8,0,0"><StackPanel><TextBlock Text="Temporary books, receipts and logs. Choose a separate local or network folder; use the same share as your books to keep processing there." Style="{StaticResource Hint}"/><DockPanel><Button x:Name="WorkBrowse" DockPanel.Dock="Right" Content="Browse" Margin="10,0,0,0"/><TextBox x:Name="WorkFolder" AutomationProperties.Name="Working folder"/></DockPanel></StackPanel></Expander>
              </StackPanel></Border>
              <Border x:Name="SimpleToolsCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your conversion tools" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SimpleToolsSummary" Style="{StaticResource Hint}"/><TextBlock Text="Use guided setup to find and check your tools, or open Advanced view to edit their paths." Style="{StaticResource Hint}"/><Button x:Name="ShowAdvancedTools" Content="Show tool settings" HorizontalAlignment="Left"/></StackPanel></Border>
              <Border x:Name="AdvancedToolsCard" Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Connect your tools" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Select existing tools once. KCCAutomate remembers them; nothing is downloaded automatically." Style="{StaticResource Hint}"/>
                <TextBlock Text="KCC command-line converter (c2e)" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="KccBrowse" DockPanel.Dock="Right" Content="Choose .exe" Margin="10,0,0,0"/><TextBox x:Name="KccExe" AutomationProperties.Name="KCC executable"/></DockPanel>
                <TextBlock Text="Use the Windows x64 tool_cli_c2e_VERSION_AMD64.exe or kcc-c2e.exe from KCC releases. It bundles Python and its Python libraries; the KCC GUI and separate Python installation are unnecessary. Use guided setup to validate it and copy tools." Style="{StaticResource Hint}"/>
                <TextBlock Text="KindleGen executable (optional if KCC already finds it)" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="KindlegenBrowse" DockPanel.Dock="Right" Content="Choose .exe" Margin="10,0,0,0"/><TextBox x:Name="KindlegenExe" AutomationProperties.Name="KindleGen executable"/></DockPanel>
                <CheckBox x:Name="ConvertJxl" Content="Automatically convert JPEG XL pages to PNG"/>
                <DockPanel><Button x:Name="DjxlBrowse" DockPanel.Dock="Right" Content="Choose .exe" Margin="10,0,0,0"/><TextBox x:Name="DjxlExe" AutomationProperties.Name="JPEG XL decoder executable"/></DockPanel>
                <TextBlock Text="Choose libjxl's djxl.exe. Originals stay unchanged. JXL books are stopped if this is disabled." Style="{StaticResource Hint}"/>
                <TextBlock Text="7-Zip executable (optional archive support)" Style="{StaticResource Label}"/>
                <DockPanel><Button x:Name="SevenZipBrowse" DockPanel.Dock="Right" Content="Choose 7z.exe" Margin="10,0,0,0"/><TextBox x:Name="SevenZipExe" AutomationProperties.Name="7-Zip executable"/></DockPanel>
                <TextBlock Text="Guided setup can import .zip/.7z JXL packages and copy tools into KCCAutomate's tools folder. Direct edits here use the selected locations." Style="{StaticResource Hint}"/>
                <StackPanel Orientation="Horizontal"><Button x:Name="CheckTools" Content="Check setup"/><Button x:Name="KccLink" Content="Open KCC releases"/><Button x:Name="JxlLink" Content="Get JXL tools"/></StackPanel>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Conversion">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Your favorite setups" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Presets store conversion options only; folders, tools and schedules stay on this PC." Style="{StaticResource Hint}"/>
              <DockPanel Margin="0,0,0,12"><Button x:Name="ApplyPreset" Content="Apply preset" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox x:Name="Presets" DisplayMemberPath="Name"/></DockPanel>
              <DockPanel Margin="0,0,0,12"><Button x:Name="SavePreset" Content="Save current options" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="PresetName" ToolTip="Preset name" Text="My Scribe manga"/></DockPanel>
              <WrapPanel x:Name="AdvancedPresetManagement"><Button x:Name="DeletePreset" Content="Delete selected"/><Button x:Name="ImportPresets" Content="Import presets"/><Button x:Name="ExportPresets" Content="Export presets"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Made for your reader" FontSize="20" FontWeight="SemiBold"/>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Device profile" Style="{StaticResource Label}"/><ComboBox x:Name="Profile" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="Device profile"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Output format" Style="{StaticResource Label}"/><ComboBox x:Name="OutputFormat" AutomationProperties.Name="Output format"><ComboBoxItem Content="MOBI"/><ComboBoxItem Content="EPUB"/><ComboBoxItem Content="CBZ"/><ComboBoxItem Content="PDF"/></ComboBox></StackPanel>
              </Grid>
              <TextBlock Text="MOBI is for compatible Kindles. Choose EPUB for Kobo. Use profiles supported by your installed KCC version." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="MangaStyle" Content="Manga mode · read right to left"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Wide, double-page spreads" Style="{StaticResource Label}"/><ComboBox x:Name="Splitter"><ComboBoxItem Content="Split into separate pages"/><ComboBoxItem Content="Rotate the complete spread"/><ComboBoxItem Content="Keep both split and complete versions"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Cropping" Style="{StaticResource Label}"/><ComboBox x:Name="Cropping"><ComboBoxItem Content="Preserve the entire page"/><ComboBoxItem Content="Remove margins"/><ComboBoxItem Content="Remove margins and page numbers"/></ComboBox></StackPanel>
              </Grid>
              <CheckBox x:Name="Upscale" Content="Enlarge smaller pages to fit the reader"/>
              <StackPanel x:Name="ScribeCompatibilityCard" Margin="0,12,0,8"><CheckBox x:Name="ScribeCompatibility" Content="Scribe compatibility mode (optional)"/>
                <TextBlock Text="For blank, cut-off or striped pages on Scribe 2022/2024 using MOBI/EPUB: use JPEG, disable cropping and limit images to 1860 × 1920. This may help Kindle rendering bugs, with lower maximum resolution and possibly larger margins. Your usual PNG/cropping choices are retained and resume when you switch this off. Try a sample on your reader; turn it off after an upstream fix." Style="{StaticResource Hint}"/>
              </StackPanel>
              <StackPanel x:Name="SimpleImageNote"><TextBlock x:Name="SimpleImageSummary" Style="{StaticResource Hint}"/><Button x:Name="ShowAdvancedConversion" Content="Show image and file settings" HorizontalAlignment="Left"/></StackPanel>
              <StackPanel x:Name="AdvancedImageControls">
              <CheckBox x:Name="Stretch" Content="Stretch pages to fill the screen (changes proportions)"/>
              <TextBlock Text="With stretching off, pages keep their proportions. Borders can remain. KCC may trim a small edge when page and screen proportions almost match." Style="{StaticResource Hint}"/>
              <Expander Header="Image adjustments" Margin="0,8,0,0"><StackPanel>
                <WrapPanel><CheckBox x:Name="Autolevel" Content="Strengthen faded blacks"/><CheckBox x:Name="NoAutocontrast" Content="Disable automatic contrast"/></WrapPanel>
                <WrapPanel><CheckBox x:Name="ForceColor" Content="Keep color pages in color"/><CheckBox x:Name="ForcePng" Content="Use PNG for black-and-white pages"/><CheckBox x:Name="Webtoon" Content="Webtoon mode"/></WrapPanel>
                <TextBlock Text="Gamma (0 = KCC automatic)" Style="{StaticResource Label}"/><TextBox x:Name="Gamma" Width="110" HorizontalAlignment="Left"/>
              </StackPanel></Expander>
              </StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="What should enter the queue?" FontSize="20" FontWeight="SemiBold"/>
              <WrapPanel Margin="0,12,0,0"><CheckBox x:Name="InputCbz" Content="CBZ"/><CheckBox x:Name="InputPdf" Content="PDF"/><CheckBox x:Name="InputEpub" Content="EPUB"/><CheckBox x:Name="InputCbr" Content="CBR"/><CheckBox x:Name="InputCb7" Content="CB7"/></WrapPanel>
              <TextBlock Text="CBZs run first, then PDFs, EPUBs, CBRs and CB7s. These settings are for image-based comics and manga. Original handling waits until all selected inputs in a folder succeed. Archive mode moves accompanying files too; deletion mode keeps unconverted files in Incoming." Style="{StaticResource Hint}"/>
              <TextBlock x:Name="SimpleFileSummary" Style="{StaticResource Hint}"/>
              <TextBlock Text="After successful conversion" Style="{StaticResource Label}"/>
              <ComboBox x:Name="OriginalsAction"><ComboBoxItem Content="Keep originals in the Originals folder (recommended)"/><ComboBoxItem Content="Permanently delete converted originals"/></ComboBox>
              <Border x:Name="DeleteOriginalsWarning" Visibility="Collapsed" Background="#FFF1EE" Padding="12" Margin="0,8,0,8"><StackPanel>
                <TextBlock Foreground="#7A2418" Text="Warning: converted original files will be permanently deleted, without going to the Recycle Bin. You may lose the ability to convert them again with different settings. Only successfully converted input files are removed; failed and unconverted files stay in Incoming." TextWrapping="Wrap"/>
                <CheckBox x:Name="DeleteOriginalsConfirmed" Foreground="#7A2418" Content="I understand that converted originals will be permanently deleted"/>
              </StackPanel></Border>
              <TextBlock Text="Keeping originals is the default. The Originals folder is unused when deletion is selected. Preview never removes anything." Style="{StaticResource Hint}"/>
              <TextBlock Text="When converted output already exists" Style="{StaticResource Label}"/>
              <ComboBox x:Name="DuplicateAction" AutomationProperties.Name="Default action for existing converted output"><ComboBoxItem Content="Review conflicts and keep incoming" IsSelected="True"/><ComboBoxItem Content="Replace existing converted books"/><ComboBoxItem Content="Keep both with numbered filenames"/><ComboBoxItem Content="Skip existing output and keep incoming"/></ComboBox>
              <TextBlock x:Name="DuplicateDescription" Style="{StaticResource Hint}"/>
              <StackPanel x:Name="AdvancedFileControls">
              <TextBlock Text="Output naming" Style="{StaticResource Label}"/><TextBox x:Name="OutputNaming" Text="{}{name}"/>
              <TextBlock Text="Use {name}, {profile} and {format}. Example: {name} - {profile}. The file extension is added automatically." Style="{StaticResource Hint}"/>
              </StackPanel>
            </StackPanel></Border>
            <Border x:Name="BookLabelsCard" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Readable book labels" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Book title and filename" Style="{StaticResource Label}"/>
              <ComboBox x:Name="BookTitleStyle"><ComboBoxItem Content="Keep original names"/><ComboBoxItem Content="Series, then number"/><ComboBoxItem Content="Number, then series"/><ComboBoxItem Content="Clean filename (keep v/ch numbering)"/></ComboBox>
              <TextBlock Text="Clean filename removes leading [release tags] and keeps the title through v01 or ch001, removing everything after that number. For example: [sunshine] Rainbows v1 [truth] becomes Rainbows v1. Matching series folders in Converted also use just the series title, including your shortened name if set. Existing ranges such as v01-02 are kept whole. Without a clear marker, only leading bracketed tags are removed; the rest of the name is kept." Style="{StaticResource Hint}"/>
              <TextBlock Text="Series-first keeps each series together when sorting by Title. Number-first shows the order before a long name, but mixes series under 001, 002, and so on. Neither changes the chapter links or reading direction inside the book." Style="{StaticResource Hint}"/>
              <TextBlock Text="Files named only v1, Vol. 2 or ch001 use their containing series folder as the title with Clean filename, Series-first or Number-first. For example: Artist/Series/v1.cbz becomes Artist/Series/Series v1.mobi with Clean filename. Artist folders are kept. Keep original names leaves the filename as downloaded." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="CoverNumberBadge" Content="Add a clear chapter/volume number strip above the cover artwork"/>
              <TextBlock Text="Only the generated cover is changed. Kindle library thumbnails depend on the reader and firmware; the numbered embedded cover cannot guarantee a thumbnail will appear." Style="{StaticResource Hint}"/>
              <StackPanel x:Name="SeriesAliasEditor">
                <TextBlock Text="Shorten really long series names (optional)" Style="{StaticResource Label}" FontSize="16"/>
                <TextBlock Text="Enter the series title on the left, without v01/ch001, publisher or release tags. Put the shorter name you want on the right. For example: The Hero and the Sage, Reincarnated and Engaged becomes Hero and Sage. Used with Clean filename, Series-first or Number-first for future conversions. Leave both boxes empty if unused." Style="{StaticResource Hint}"/>
                <StackPanel x:Name="SeriesAliasRows"/>
                <Button x:Name="AddSeriesAlias" Content="Add another series" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel></Border>
            <Border x:Name="BookBundlesCard" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Combine chapters or whole volumes" FontSize="20" FontWeight="SemiBold"/>
              <CheckBox x:Name="BundleChapters" Content="Combine short CBZ chapters into volume-sized books"/>
              <CheckBox x:Name="BundleVolumes" Content="Combine complete CBZ volumes into fewer books"/>
              <TextBlock Text="Chapters and volumes form separate groups. Each group keeps complete units in number order, rounding down before a unit would cross your page or size budget. These are reading bundles, which may differ from official published volumes." Style="{StaticResource Hint}"/>
              <TextBlock Text="Target source pages per book" Style="{StaticResource Label}"/><TextBox x:Name="BundleTargetPages" Text="200" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="Treat files below this many source pages as likely chapters" Style="{StaticResource Label}"/><TextBox x:Name="ChapterPageThreshold" Text="100" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="Target source pages per combined-volume book" Style="{StaticResource Label}"/><TextBox x:Name="VolumeTargetPages" Text="600" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="Filename markers take priority: v01, Vol. 1 or Volume 1 means a volume; ch001, Ch. 1 or Chapter 1 means a chapter. Page count is used when no marker is present. Units above their grouping page target and volumes with unclear numbering convert separately. One source image counts as one page, before spread splitting." Style="{StaticResource Hint}"/>
              <TextBlock Text="Maximum converted bundle size (MiB)" Style="{StaticResource Label}"/><TextBox x:Name="BundleMaxMiB" Text="350" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="A conservative size budget. If KCC splits a bundle or its output exceeds this budget, the app retries with fewer whole chapters or volumes. A unit that cannot fit stays in Incoming with an explanation." Style="{StaticResource Hint}"/>
              <CheckBox x:Name="HoldShortBundles" Content="Keep short leftover groups in Incoming until more chapters or volumes arrive" IsChecked="False"/>
              <TextBlock Text="Turn this off to create short final bundles now. Preview shows the grouping and any inputs waiting. Original handling runs only when every selected input in the folder has verified output. Existing published bundles are kept stable." Style="{StaticResource Hint}"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Queue">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Your books, at a glance" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="QueueSummary" Text="Refresh to inspect incoming books and recent results." Style="{StaticResource Hint}"/>
              <TextBlock x:Name="QueueRunStatus" Text="" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
              <TextBlock x:Name="QueueNetwork" Text="Folder availability has not been checked yet." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
              <TextBlock x:Name="QueueSchedule" Text="Check schedule to see the next automatic run." Style="{StaticResource Hint}"/>
              <WrapPanel Margin="0,0,0,12"><Button x:Name="RefreshQueue" Content="Refresh queue"/><Button x:Name="RetrySelected" Content="Retry selected"/><ComboBox x:Name="QueueFilter" Width="160"><ComboBoxItem Content="All books" IsSelected="True"/><ComboBoxItem Content="Needs attention"/><ComboBoxItem Content="Waiting"/><ComboBoxItem Content="Completed"/></ComboBox><StackPanel Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="On retry" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RetryAction" Width="190" ToolTip="One-run choice for selected output conflicts. Your saved default is unchanged." AutomationProperties.Name="One-run action for selected output conflicts"><ComboBoxItem Content="Saved default" IsSelected="True"/><ComboBoxItem Content="Replace existing"/><ComboBoxItem Content="Keep both"/><ComboBoxItem Content="Skip; keep incoming"/></ComboBox></StackPanel></WrapPanel>
            </StackPanel>
            <DataGrid x:Name="QueueGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" RowHeight="36" HeadersVisibility="Column" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}" HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145"/><DataGridTextColumn Header="Book" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="JXL pages" Binding="{Binding JxlPages}" Width="75"/><DataGridTextColumn Header="Folder" Binding="{Binding Batch}" Width="140"/></DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="15"><StackPanel><TextBlock x:Name="QueueDetail" Text="Select a book for its output path, status and suggested fix." TextWrapping="Wrap"/><TextBlock x:Name="QueueAdvice" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border>
          </Grid>
        </TabItem>
        <TabItem Header="Preferences">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
            <Border x:Name="SimpleSettingsCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your saved preferences" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SimpleSettingsSummary" Style="{StaticResource Hint}"/><Button x:Name="ShowAdvancedSettings" Content="Show all preferences" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border x:Name="AdvancedCleanupCard" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Keep things tidy" FontSize="20" FontWeight="SemiBold"/>
              <CheckBox x:Name="AutoCleanup" Content="Clean old temporary attempts after conversion checks"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Keep successful attempts (days)" Style="{StaticResource Label}"/><TextBox x:Name="SuccessRetentionDays" Text="7"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Keep failed attempts (days)" Style="{StaticResource Label}"/><TextBox x:Name="FailureRetentionDays" Text="30"/></StackPanel>
              </Grid>
              <TextBlock Text="Cleanup removes only old attempt subfolders. Originals, converted books, logs and completion receipts stay." Style="{StaticResource Hint}"/>
              <WrapPanel><Button x:Name="WorkspaceUsage" Content="Check space usage"/><Button x:Name="CleanupNow" Content="Clean expired attempts"/></WrapPanel>
              <TextBlock x:Name="SpaceUsage" Text="Space usage has not been checked." Style="{StaticResource Hint}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Make it yours" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Appearance" Style="{StaticResource Label}"/><ComboBox x:Name="Theme"><ComboBoxItem Content="Light" IsSelected="True"/><ComboBoxItem Content="Dark"/></ComboBox>
              <TextBlock Text="Desktop notifications" Style="{StaticResource Label}"/><ComboBox x:Name="NotificationMode"><ComboBoxItem Content="Off" IsSelected="True"/><ComboBoxItem Content="Errors only"/><ComboBoxItem Content="Every check"/></ComboBox>
              <StackPanel x:Name="AdvancedQuietHours"><CheckBox x:Name="QuietHoursEnabled" Content="Silence notifications during these hours"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="QuietHoursStart" Text="22:00"/><TextBox x:Name="QuietHoursEnd" Grid.Column="2" Text="08:00"/></Grid>
              <TextBlock Text="Use 24-hour times. Notifications follow Windows notification preferences and appear while you are signed in." Style="{StaticResource Hint}"/>
              </StackPanel>
            </StackPanel></Border>
            <Border x:Name="AdvancedRulesCard" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="A different setup for a favorite series" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Rules match paths relative to the watch folder, for example Series A\*. The first matching rule uses its named preset. Save settings after editing." Style="{StaticResource Hint}"/>
              <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="150" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Folder pattern" Binding="{Binding Pattern}" Width="*"/><DataGridTextColumn Header="Preset name" Binding="{Binding PresetName}" Width="*"/></DataGrid.Columns></DataGrid>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="AddRule" Content="Add rule"/><Button x:Name="DeleteRule" Content="Remove selected rule"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Updates, on your terms" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="AppVersion" Text="KCCAutomate 0.1.20" Style="{StaticResource Hint}"/>
              <TextBlock x:Name="SimpleUpdateSource" Style="{StaticResource Hint}"/>
              <StackPanel x:Name="AdvancedRepository"><TextBlock Text="KCCAutomate GitHub repository (owner/repository)" Style="{StaticResource Label}"/><TextBox x:Name="UpdateRepository"/>
              <TextBlock Text="Use the trusted repository publishing KCCAutomate releases. App, KCC and JPEG XL checks use their latest stable releases. KCC downloads remain user-managed through its releases page." Style="{StaticResource Hint}"/>
              </StackPanel>
              <Button x:Name="CheckUpdates" Content="Check GitHub for updates" HorizontalAlignment="Left"/>
              <DataGrid x:Name="UpdatesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" Margin="0,14,0,10" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="*"/><DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="100"/><DataGridTextColumn Header="Offered" Binding="{Binding Latest}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
              <TextBox x:Name="ReleaseNotes" IsReadOnly="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="DownloadUpdate" Content="Download &amp; verify selected"/><Button x:Name="InstallUpdate" Content="Install / use verified version"/><Button x:Name="RollbackUpdate" Content="Restore previous version"/></WrapPanel>
              <TextBlock Text="KCC is downloaded by you from its GitHub releases page, then selected in setup. App and JXL downloads are checked against GitHub's SHA-256 digest. App installation waits for conversion to be idle, preserves settings and backs up the current app. Changing repositories changes whom you trust." Style="{StaticResource Hint}"/>
              <TextBlock x:Name="UpdateStatus" Text="No updates checked yet." Style="{StaticResource Hint}"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Schedule">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="A rhythm that fits your day" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Windows checks the watch folder at these times, even when KCCAutomate is closed." Style="{StaticResource Hint}"/>
              <TextBlock Text="Daily check times · 24-hour clock" Style="{StaticResource Label}"/>
              <TextBox x:Name="ScheduleTimes" Text="08:00, 14:00, 20:00"/>
              <TextBlock Text="Separate times with commas. For example: 08:00, 14:00, 20:00." Style="{StaticResource Hint}"/>
              <TextBlock x:Name="SimpleScheduleSummary" Style="{StaticResource Hint}"/>
              <StackPanel x:Name="AdvancedScheduleControls"><TextBlock Text="Wait after a file was last modified (minutes)" Style="{StaticResource Label}"/>
              <TextBox x:Name="QuietMinutes" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="Default: 30 minutes. Download elsewhere, then move completed downloads into the watch folder for the most reliable results." Style="{StaticResource Hint}"/>
              </StackPanel>
              <CheckBox x:Name="WakeComputer" Content="Ask Windows to wake the computer for scheduled checks"/>
              <Border Background="{DynamicResource SoftBrush}" Padding="16" CornerRadius="8" Margin="0,14,0,20"><TextBlock Text="Checks run while your Windows account is signed in, including when the screen is locked. The PC must be on and able to reach your folders. No administrator password is stored. To run while signed out, change the task's account settings in Windows Task Scheduler." TextWrapping="Wrap"/></Border>
              <WrapPanel><Button x:Name="EnableSchedule" Content="Save &amp; enable schedule" Style="{StaticResource Primary}"/><Button x:Name="DisableSchedule" Content="Disable schedule"/><Button x:Name="ScheduleStatus" Content="Check schedule"/></WrapPanel>
              <TextBlock Text="Disable any older manga conversion task before enabling this one. Keep this app folder in its current location after scheduling." Style="{StaticResource Hint}"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Activity">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Every book, accounted for" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Preview shows the queue without changing files. Run now converts, verifies successful batches and applies your chosen original-handling policy." Style="{StaticResource Hint}"/>
              <WrapPanel Margin="0,0,0,12"><Button x:Name="OpenLog" Content="Load conversion log"/><Button x:Name="OpenWork" Content="Open working folder"/><Button x:Name="ClearActivity" Content="Clear view"/><Button x:Name="StopAfter" Content="Stop after this file" IsEnabled="False"/></WrapPanel>
            </StackPanel>
            <TextBox x:Name="Activity" Grid.Row="1" Background="#182B23" Foreground="#D7E9CF" FontFamily="Consolas" FontSize="12" Padding="18" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock Grid.Row="2" Text="Failed folders stay in place. Detailed KCC and JXL logs live inside the working folder." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,12,0,0">
        <DockPanel><TextBlock x:Name="SavedState" Text="Settings stay on this PC." Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveSettings" Content="Save settings"/><Button x:Name="Preview" Content="Preview queue"/><Button x:Name="StopNow" Content="Stop" IsEnabled="False" BorderBrush="#A7443B"/><Button x:Name="RunNow" Content="Run now" Style="{StaticResource Primary}" Margin="0"/></StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
