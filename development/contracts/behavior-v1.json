{
  "schemaVersion": 1,
  "description": "Replay these scenarios against the current Windows worker and future native adapters. Fake converters test workflow behavior, not ebook quality or platform readiness.",
  "settings": {
    "Profile": "KS",
    "Format": "MOBI",
    "Cropping": 0,
    "Splitter": 0,
    "MangaStyle": true,
    "Upscale": true,
    "ConvertJxl": true,
    "QuietMinutes": 0,
    "InputExtensions": [
      ".cbz",
      ".pdf"
    ],
    "DuplicateAction": "Review",
    "OutputNaming": "{name}"
  },
  "scenarios": [
    {
      "id": "order-and-archive-merge",
      "settings": {},
      "files": {
        "incoming": [
          {
            "path": "Series [A]/one.cbz",
            "kind": "cbz",
            "content": "source",
            "ageMinutes": 120
          },
          {
            "path": "Series [A]/two.pdf",
            "kind": "text",
            "content": "source",
            "ageMinutes": 120
          },
          {
            "path": "Series [A]/notes.txt",
            "kind": "text",
            "content": "notes",
            "ageMinutes": 120
          },
          {
            "path": "Loose.pdf",
            "kind": "text",
            "content": "source",
            "ageMinutes": 120
          }
        ],
        "originals": [
          {
            "path": "Series [A]/one.cbz",
            "kind": "text",
            "content": "stale",
            "ageMinutes": 120
          },
          {
            "path": "Series [A]/keep.txt",
            "kind": "text",
            "content": "keep",
            "ageMinutes": 120
          }
        ]
      },
      "runs": [
        {
          "command": "run",
          "expect": {
            "windowsExitCode": 0,
            "workerExitCode": 0,
            "trees": {
              "incoming": [],
              "converted": [
                "Series [A]/one.mobi",
                "Series [A]/two.mobi",
                "Loose.mobi"
              ],
              "originals": [
                "Series [A]/one.cbz",
                "Series [A]/two.pdf",
                "Series [A]/notes.txt",
                "Series [A]/keep.txt",
                "Loose.pdf"
              ]
            },
            "callFormats": [
              ".cbz",
              ".pdf",
              ".pdf"
            ],
            "states": {},
            "unchanged": [
              "originals:Series [A]/keep.txt"
            ],
            "archivedFromIncoming": [
              "Series [A]/one.cbz",
              "Series [A]/two.pdf",
              "Series [A]/notes.txt",
              "Loose.pdf"
            ]
          }
        }
      ]
    },
    {
      "id": "failure-isolation-and-receipt-retry",
      "settings": {},
      "files": {
        "incoming": [
          {
            "path": "Series/good.cbz",
            "kind": "cbz",
            "content": "source",
            "ageMinutes": 120
          },
          {
            "path": "Series/fail.pdf",
            "kind": "text",
            "content": "source",
            "ageMinutes": 120
          },
          {
            "path": "Other/book.cbz",
            "kind": "cbz",
            "content": "source",
            "ageMinutes": 120
          }
        ]
      },
      "runs": [
        {
          "command": "run",
          "expect": {
            "windowsExitCode": 1,
            "workerExitCode": 1,
            "trees": {
              "incoming": [
                "Series/good.cbz",
                "Series/fail.pdf"
              ],
              "converted": [
                "Series/good.mobi",
                "Other/book.mobi"
              ],
              "originals": [
                "Other/book.cbz"
              ]
            },
            "callFormats": [
              ".cbz",
              ".cbz",
              ".pdf"
            ],
            "states": {
              "Series/fail.pdf": "failed",
              "Other/book.cbz": "archived"
            },
            "unchanged": [
              "incoming:Series/good.cbz",
              "incoming:Series/fail.pdf"
            ],
            "archivedFromIncoming": [
              "Other/book.cbz"
            ]
          }
        },
        {
          "command": "run",
          "allowFailures": true,
          "expect": {
            "windowsExitCode": 0,
            "workerExitCode": 0,
            "trees": {
              "incoming": [],
              "converted": [
                "Series/good.mobi",
                "Series/fail.mobi",
                "Other/book.mobi"
              ],
              "originals": [
                "Series/good.cbz",
                "Series/fail.pdf",
                "Other/book.cbz"
              ]
            },
            "callFormats": [
              ".pdf"
            ],
            "states": {},
            "unchanged": [],
            "archivedFromIncoming": [
              "Series/good.cbz",
              "Series/fail.pdf",
              "Other/book.cbz"
            ]
          }
        }
      ]
    },
